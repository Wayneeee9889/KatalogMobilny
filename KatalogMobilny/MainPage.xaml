<?xml version="1.0" encoding="utf-8" ?>
    
    <!-- content page może mieć tylko jednego potomka -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">

    <VerticalStackLayout Padding="16" x:Name="MainLayout">
        <Label Text="Processor" FontSize="12" FontAutoScalingEnabled="True" FontFamily="verdana" HorizontalOptions="Center" Margin="0,20"/>
        <Image Source="processor.jpg" HorizontalOptions="Center"/>
        <Label Text="Model cpu: ryzen 7" TextColor="Grey" HorizontalOptions="Center"/>
        <Label Text="Prędkość cpu: 4.2 GHz" TextColor="Grey" HorizontalOptions="Center"/>
        <Label Text="Socket cpu: Socket AM5" TextColor="Grey" HorizontalOptions="Center"/>
        <Label Text="Manifaktura cpu: AMD" TextColor="Grey" HorizontalOptions="Center"/>
        <Label Text="Cena: 899zł" TextColor="Grey" HorizontalOptions="Center"/>
        <Label x:Name="EtykietaWyniku" Text="Nic nie wybrano" HorizontalOptions="Center"/>
        <Button Text="Wybierz" Clicked="PokazButton"/>
    </VerticalStackLayout>
